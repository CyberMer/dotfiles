# Hyprland gitignore

# Log files
*.log

# Temporary files
*~
*.tmp
*.swp
*.bak

# Personal/sensitive files
*secret*
*private*

# Cache directories
.cache/

# Backup files
*.backup
hyprland.conf.backup*

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
# Generated by Dux Shell (not loaded by hyprland.lua)
dms/

# Charity photos show recognizable people — keep them local, out of the public repo
wallpapers/charity_*

# Machine-specific / private — never published
local.lua
scripts/douga-toggle.sh
hyprlock/avatar.png
hyprlock/friends_*
wallpapers/macos/
scripts/__pycache__/

# Only two wallpapers are published
wallpapers/*
!wallpapers/nature_09.jpg
!wallpapers/city_03.jpg
